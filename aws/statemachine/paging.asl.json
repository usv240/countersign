{
  "Comment": "Countersign paging: page the call list until a human decides. Only an officer's decision, through the approval service, ends it. The agent has no permission here. A failing pager is retried, then escalated to the state desk; if the paging functions themselves are down, the workflow pages the state desk directly through SNS, with no Lambda in the path, and then fails so the paging-failed alarm fires. An error can never end the paging quietly.",
  "StartAt": "Start",
  "States": {
    "Start": {
      "Type": "Pass",
      "Parameters": {
        "run_id.$": "$.run_id",
        "warning_title.$": "$.warning_title",
        "contacts.$": "$.contacts",
        "timeout.$": "$.timeout",
        "max_rounds.$": "$.max_rounds",
        "index": 0,
        "round": 1
      },
      "Next": "PageContact"
    },
    "PageContact": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${PagerArn}",
        "Payload": {
          "token.$": "$$.Task.Token",
          "run_id.$": "$.run_id",
          "warning_title.$": "$.warning_title",
          "contact.$": "States.ArrayGetItem($.contacts, $.index)",
          "round.$": "$.round"
        }
      },
      "TimeoutSecondsPath": "$.timeout",
      "ResultPath": "$.decision",
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "ResultPath": "$.timed_out",
          "Next": "NextContact"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.pager_error",
          "Next": "EscalateToState"
        }
      ],
      "Next": "Decided",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "Lambda.Unknown"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0,
          "JitterStrategy": "FULL"
        },
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2.0,
          "JitterStrategy": "FULL"
        }
      ]
    },
    "NextContact": {
      "Type": "Pass",
      "Parameters": {
        "run_id.$": "$.run_id",
        "warning_title.$": "$.warning_title",
        "contacts.$": "$.contacts",
        "timeout.$": "$.timeout",
        "max_rounds.$": "$.max_rounds",
        "index.$": "States.MathAdd($.index, 1)",
        "round.$": "$.round",
        "count.$": "States.ArrayLength($.contacts)"
      },
      "Next": "EndOfList"
    },
    "EndOfList": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.index",
          "NumericEqualsPath": "$.count",
          "Next": "NewRound"
        }
      ],
      "Default": "PageContact"
    },
    "NewRound": {
      "Type": "Pass",
      "Parameters": {
        "run_id.$": "$.run_id",
        "warning_title.$": "$.warning_title",
        "contacts.$": "$.contacts",
        "timeout.$": "$.timeout",
        "max_rounds.$": "$.max_rounds",
        "index": 0,
        "round.$": "States.MathAdd($.round, 1)"
      },
      "Next": "RoundsLeft"
    },
    "RoundsLeft": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.round",
          "NumericGreaterThanPath": "$.max_rounds",
          "Next": "EscalateToState"
        }
      ],
      "Default": "PageContact"
    },
    "EscalateToState": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${EscalatedArn}",
        "Payload": {
          "run_id.$": "$.run_id"
        }
      },
      "ResultPath": null,
      "Next": "WaitForState",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "Lambda.Unknown"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2.0,
          "JitterStrategy": "FULL"
        },
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2.0,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.pager_error",
          "Next": "LastResortRecord"
        }
      ]
    },
    "WaitForState": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${PagerArn}",
        "Payload": {
          "token.$": "$$.Task.Token",
          "run_id.$": "$.run_id",
          "warning_title.$": "$.warning_title",
          "contact": {
            "name": "State warning point",
            "role": "24-hour state desk"
          },
          "round.$": "$.round"
        }
      },
      "TimeoutSeconds": 3600,
      "ResultPath": "$.decision",
      "Next": "Decided",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "Lambda.Unknown"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0,
          "JitterStrategy": "FULL"
        },
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2.0,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.pager_error",
          "Next": "LastResortRecord"
        }
      ]
    },
    "Decided": {
      "Type": "Succeed"
    },
    "LastResortRecord": {
      "Type": "Task",
      "Comment": "Written by Step Functions itself, so the review page shows the page even with every paging function down.",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "cs-ledger",
        "Item": {
          "pk": {
            "S.$": "States.Format('CHANNEL#{}', $.run_id)"
          },
          "sk": {
            "S": "999999999999#page#last-resort"
          },
          "channel": {
            "S": "pager"
          },
          "body": {
            "M": {
              "contact": {
                "M": {
                  "name": {
                    "S": "State warning point"
                  },
                  "role": {
                    "S": "24-hour state desk, direct"
                  }
                }
              },
              "text": {
                "S": "Countersign's paging functions failed. This page was sent by the workflow itself. An official warning needs a decision."
              },
              "warning": {
                "S.$": "$.warning_title"
              },
              "sent_at": {
                "S.$": "$$.State.EnteredTime"
              },
              "last_resort": {
                "BOOL": true
              }
            }
          }
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 5,
          "BackoffRate": 2.0,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.record_error",
          "Next": "LastResortPage"
        }
      ],
      "Next": "LastResortPage"
    },
    "LastResortPage": {
      "Type": "Task",
      "Comment": "A page with no Lambda in the path.",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${PagerTopicArn}",
        "Message.$": "States.Format('Countersign LAST RESORT page to the state warning point (24-hour desk): the county paging functions failed. Warning: {}. Run: {}. Open the review page.', $.warning_title, $.run_id)"
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 5,
          "BackoffRate": 2.0,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "PagingBroken"
    },
    "PagingBroken": {
      "Type": "Fail",
      "Error": "PagingFunctionsFailed",
      "Cause": "The paging functions failed; the state desk was paged directly. The cs-paging-failed alarm fires on this."
    }
  }
}